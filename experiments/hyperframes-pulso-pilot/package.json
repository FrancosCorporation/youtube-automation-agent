{
  "name": "hyperframes-pulso-pilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pilot.js",
    "make-video": "node scripts/make-video.js",
    "dev": "npx --yes hyperframes@0.8.185 preview",
    "check": "npx --yes hyperframes@0.8.185 check",
    "render": "npx --yes hyperframes@0.8.185 render",
    "render:portrait": "npx --yes hyperframes@0.8.185 render --composition=variants/portrait/index.html --fps=24 --quality=high --workers=1",
    "publish": "npx --yes hyperframes@0.8.185 publish"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "gsap": "3.14.2",
    "three": "0.186.1"
  }
}
