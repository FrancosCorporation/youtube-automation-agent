# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider - Pick one (or use OpenRouter for access to all)
# Uncomment the line you use — placeholder values must stay commented out
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# ElevenLabs TTS (optional, higher quality than OpenAI TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here

# AI video generation (optional; local slideshow is the no-cost default)
# VIDEO_PROVIDER=slideshow
# VIDEO_PROVIDER_ORDER=seedance,minimax_h3,google_omni,kling,wan,slideshow
# VIDEO_GENERATION_MODE=hybrid
# VIDEO_CLIP_DURATION=8
# VIDEO_MAX_GENERATED_SECONDS=60
# Production default: animated (HyperFrames visual kit). Optional legacy overrides:
# SLIDESHOW_STYLE=dynamic  # AI images with Ken Burns motion
# SLIDESHOW_STYLE=classic  # text slides
# SLIDESHOW_SECONDS_PER_IMAGE=3.5
# Gemini image providers: persistent Chromium profile and a browser on the
# Android emulator. Android device/browser overrides are Gemini-only, so they
# do not change the device routing used by social upload handlers.
# GEMINI_IMAGE_PROVIDER=android
# GEMINI_ANDROID_FALLBACK=1
# GEMINI_ANDROID_DEVICE=emulator-5560
# GEMINI_ANDROID_BROWSER_PACKAGE=com.android.chrome
# GEMINI_ANDROID_TIMEOUT_MS=180000
# GEMINI_WEB=0 disables the Chromium provider.
# GEMINI_WEB=1
# GEMINI_WEB_HEADLESS=1
# GEMINI_WEB_PROFILE=data/browser-profiles/gemini
# GEMINI_WEB_CDP_URL=http://127.0.0.1:9223
# VIDEO_RESOLUTION=720p
# VIDEO_ASPECT_RATIO=16:9

# Seedance 2.5 through Replicate
# REPLICATE_API_TOKEN=your-replicate-api-token-here
# REPLICATE_API_KEY=your-replicate-api-token-here
# SEEDANCE_MODEL=bytedance/seedance-2.5

# MiniMax H3
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_VIDEO_MODEL=MiniMax-H3

# Google Gemini Omni Flash uses GEMINI_API_KEY above
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Kling 3.0 Omni
# KLING_ACCESS_KEY=your-kling-access-key-here
# KLING_SECRET_KEY=your-kling-secret-key-here
# KLING_VIDEO_MODEL=kling-v3-omni

# Alibaba Wan 2.7
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_VIDEO_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# DASHSCOPE_TASK_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/tasks

# Gemini media generation (used when GEMINI_API_KEY is your provider)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# DarkzSEO discoverability preflight (bundled and advisory; external checkout is explicit and falls back safely)
# DARKZSEO_PYTHON=python
# DARKZSEO_PATH=../darkzseo/darkzseo.py
# DARKZSEO_TIMEOUT_MS=30000

# Optional OAuth loopback override; Desktop app credentials are required.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1

# Azure Speech TTS (optional alternative)
# AZURE_SPEECH_KEY=your-azure-speech-key-here
# AZURE_SPEECH_REGION=eastus

# Application Settings
NODE_ENV=production
PORT=3456
# Local-only by default. Set a non-loopback IP only when API_KEY is configured.
API_BIND_HOST=127.0.0.1
LOG_LEVEL=info

# Optional local tool/model overrides for reproducible media generation.
# Defaults use python3, PATH/home edge-tts, and ~/.cache/pulso/models.
# Optional neural Python environment: see docs/runtime-audio-neural.md and requirements-neural.lock.
# In the production scheduler this remains an explicit opt-in: if Edge TTS
# word-boundary metadata is unavailable, use regular Edge TTS and then gTTS so
# a transient alignment/provider failure does not stop an approved episode.
# TTS_ALLOW_PROVIDER_FALLBACK=1
# TTS_PROVIDER=auto
# TTS_VOICE=pt-BR-FranciscaNeural
# TTS_RATE=-3%
# TTS_PITCH=-1Hz
# PULSO_DETERMINISTIC_SCENE_FALLBACK=1
# Pipelined YouTube masters target 950 spoken words (~6–7 min); lower values are ignored.
# PULSO_NARRATIVE_WORD_BUDGET=1000
# Shared training/render gate; the supervised unit uses 0.95 while retaining
# CPU affinity, low priority, memory, swap and VRAM checks.
# PULSO_SHARED_RENDER_LOAD_RATIO=1.10
# PYTHON_PATH=/usr/bin/python3
# PYTHON_PATH=/path/to/youtube-automation-agent/.venv-neural/bin/python
# EDGE_TTS_PATH=/path/to/edge-tts
# PULSO_RHUBARB_PATH=/path/to/rhubarb
# PULSO_PIPER_MODEL=/path/to/models/piper/pt_BR-faber-medium.onnx
# PULSO_PIPER_MODEL_SHA256=858555e3a064209c57088fe6bd70c4c3dc54d03eaa00c45d5ecaf43a33f95aa7
# PULSO_MODELS_DIR=/path/to/models
# PULSO_WHISPER_MODEL_PATH=/path/to/models/models--Systran--faster-whisper-base/snapshots/<revision>

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# Social video guardrails (seconds; app and account limits can differ)
# YouTube long-form defaults to 15 min until the account's extended uploads are verified.
# Set YT_MAX_VIDEO_SECONDS=43200 only for a verified channel (12 h is the platform ceiling).
# YouTube Shorts: 3 min max. Instagram discovery guidance discourages Reels above 3 min;
# narrative parts target at most 2m59s and short narratives below 60s are not published.
# TikTok narrative parts are shared only when every part is longer than 60s, the
# Creator Rewards video-duration requirement; account eligibility is separate.
# Reels above 3 min are not recommended to new audiences. Graph API has a 15 min cap.
# TikTok is conservatively set to 3 min because the Android account/app flow is not validated.
# Kwai's local 300 sec cap is conservative and still needs confirmation for file upload in the app.
# X Android: 140 sec by default; X Premium supports up to 10 min in the Android app.
# Web/iOS Premium's <4-hour allowance does not apply to this Android publisher.
# Telegram Android: no published duration ceiling; 2 GiB per file, or 4 GiB with Premium.
# SOCIAL_TIKTOK_MAX_SECONDS=180
# SOCIAL_KWAI_MAX_SECONDS=300
# YT_MAX_VIDEO_SECONDS=900
# SOCIAL_INSTAGRAM_PART_SECONDS=179
# SOCIAL_INSTAGRAM_APP_MAX_SECONDS=1200
# SOCIAL_TELEGRAM_MAX_BYTES=2147483648
# Legacy alias for SOCIAL_INSTAGRAM_PART_SECONDS only:
# SOCIAL_INSTAGRAM_MAX_SECONDS=179
# Automatic social output uses complete vertical narrative parts; generic sentence cuts are not published.
# Leave MAX_SHORTS unset to queue every eligible narrative part; set an explicit integer only to cap Shorts.
# MAX_SHORTS=3

# Published local video files are removed automatically after destination confirmation.
# QA-rejected media is retired before its later recreation; there is no local-copy retention override.
# SOCIAL_CAPTION_WORDS=12
# SOCIAL_CLIP_IMAGE_COUNT=2
# HyperFrames subprocess watchdogs (milliseconds). The production check may take
# about 20 minutes for a long master; these limits stop genuine hangs without
# interrupting normal full-length renders. Configured values above 24 h are ignored.
# HYPERFRAMES_CHECK_TIMEOUT_MS=2700000
# HYPERFRAMES_RENDER_TIMEOUT_MS=10800000
# X_MAX_VIDEO_SECONDS=140
# X full report publishing remains disabled until the Android account tier is
# confirmed. After confirming Premium, a maximum up to 600 seconds may be set.
# X_POST_FULL_VIDEO=0
# For Premium in the Android app, set:
# X_MAX_VIDEO_SECONDS=600
# X_POST_FULL_VIDEO=1
# X_UPLOAD_TIMEOUT_MS=1200000

# Social-app login checks run on configured Android devices (Redroid for Kwai; Google Play AVD for Instagram/TikTok/X).
# Android helpers search ~/.local/bin/adb and PATH by default; override when needed.
# ANDROID_DEVICE=127.0.0.1:5555
# ADB_PATH=/path/to/adb
# ANDROID_APP_TIKTOK_PACKAGE=com.zhiliaoapp.musically
# ANDROID_APP_INSTAGRAM_PACKAGE=com.instagram.android
# ANDROID_APP_X_PACKAGE=com.twitter.android
# ANDROID_APP_TELEGRAM_PACKAGE=org.telegram.messenger
# ANDROID_APP_KWAI_PACKAGE=kwai.lite.video
# Owner-approved handles are required before native publishing on these accounts.
# ANDROID_SOCIAL_HANDLE_INSTAGRAM=@approved_handle
# ANDROID_SOCIAL_HANDLE_TIKTOK=@approved_handle
# ANDROID_SOCIAL_HANDLE_X=@approved_handle

# YouTube Settings
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
# Required when API_BIND_HOST exposes the service beyond this machine. When set,
# all /api routes plus /analytics, /schedule, /generate and /publish require it.
API_KEY=

# Optional. Generation jobs run one at a time by default to control API spend.
MAX_CONCURRENT_JOBS=1

# Optional. Each retry-safe generation stage gets one bounded retry by default.
GENERATION_STAGE_MAX_ATTEMPTS=2
GENERATION_RETRY_BASE_MS=1000

# Optional Slack/Discord-compatible webhook for failures and review alerts.
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/...

# --- Operação da produtora (scheduler 24h) ---

# Intervalo para descobrir retries sociais já elegíveis; não altera os slots de novos vídeos.
# SOCIAL_RETRY_INTERVAL_MINUTES=5
# Maximum distinct social platforms attempted across eligible videos in each retry pass (1-4).
# SOCIAL_UPLOADS_PER_RETRY=4
# YOUTUBE_RETRY_INTERVAL_MINUTES=30

# Recap semanal por tema; desabilitado por padrão até decisão explícita de agenda.
# Quando habilitado, ocupa um slot normal após uma janela completa e exige duas fontes elegíveis no ledger.
# ENABLE_WEEKLY_RECAP=1
# RECAP_EVERY_DAYS=7
# Opcional: âncora ISO-8601 para o primeiro limite da janela; por padrão usa scheduler.json startedAt.
# RECAP_ANCHOR_AT=2026-10-17T12:00:00.000Z

# Alertas de falha via Telegram (opcional): bot token + chat ID do admin.
# O scheduler avisa quando geração/publicação falha ou ciclo é perdido.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Limite diário de chamadas à API NVIDIA (roteiro + crítico + SEO).
# Padrão 200 — margem ~4x acima do consumo normal (5 vídeos/dia).
# NVIDIA_CALLS_PER_DAY=200

# Nível base da trilha instrumental original (máximo 10%; voz permanece à frente).
# BGM_GAIN=0.10

# Desliga o crítico de roteiro (segunda passada LLM) e o SEO dinâmico.
# NO_SCRIPT_CRITIC=1
# NO_SEO=1

# Trilhas de fundo: coloque .mp3/.m4a/.ogg em data/assets/music/<mood>/
# (moods: epic | curious | tense | light) — ver data/assets/music/README.md

# O mascote apresentador 3D fica em assets/scenes/presenter-atlas.png.
# Para editar aparência/expressões, ajuste scripts/render-presenter-atlas.py e regenere o atlas.

# Optional anonymous activation milestones (OFF by default).
# No telemetry is sent unless both values are explicitly configured.
# Payload: milestone name, timestamp, Lumen version, OS family, Node major,
# and a random installation ID. Never includes channel, topic, title, keys, or files.
# ANONYMOUS_TELEMETRY_ENABLED=false
# ANONYMOUS_TELEMETRY_ENDPOINT=https://your-collector.example/events

# Maximum agent-posted comment replies per day (Engagement studio; default 50)
# ENGAGEMENT_DAILY_REPLY_CAP=50

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
